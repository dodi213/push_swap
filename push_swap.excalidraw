    {
      "id": "txt_h1ywygrjbbL4cX",
      "type": "text",
      "x": 4368.9998779296875,
      "y": 3195,
      "width": 431.20000000000005,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6j",
      "roundness": null,
      "seed": 75946817,
      "version": 256,
      "versionNonce": 2086834218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368030,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "2. process_tokens(tokens, &cfg) -> j = 0:\n   • validate_and_add(\"7\", &cfg) -> num = 7, sign = +1\n   • has_duplicate(stack_a, 7):\n     scans [1, 2, 4, 8, 3, 5, 6] -> 0 (unique!)\n   • append_node(&stack_a, 7):\n     allocates Node #7 (val=7)\n     walks curr to tail Node #6 (val=6)\n     links tail->next = Node #7, Node #7->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. process_tokens(tokens, &cfg) -> j = 0:\n   • validate_and_add(\"7\", &cfg) -> num = 7, sign = +1\n   • has_duplicate(stack_a, 7):\n     scans [1, 2, 4, 8, 3, 5, 6] -> 0 (unique!)\n   • append_node(&stack_a, 7):\n     allocates Node #7 (val=7)\n     walks curr to tail Node #6 (val=6)\n     links tail->next = Node #7, Node #7->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
