      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368031,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "append_node(&cfg->stack_a, (int)(num * sign)):\n  • if (has_duplicate(*stack, val)) return (0);\n  • new_node = malloc(sizeof(t_node));\n  • Links to tail of cfg->stack_a\n  • Returns 1 on success",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "append_node(&cfg->stack_a, (int)(num * sign)):\n  • if (has_duplicate(*stack, val)) return (0);\n  • new_node = malloc(sizeof(t_node));\n  • Links to tail of cfg->stack_a\n  • Returns 1 on success",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
