    {
      "id": "txt__eYm3MuTX9jAbA",
      "type": "text",
      "x": 3142.9998779296875,
      "y": 3820,
      "width": 386.40000000000003,
      "height": 206.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b99",
      "roundness": null,
      "seed": 853825024,
      "version": 256,
      "versionNonce": 1005967786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368031,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "Key Structural Takeaways:\n• Order is strictly preserved:\n  \"1 2 4 8\" -> 1, 2, 4, 8 (top 4 elements)\n  3 5 6 7   -> 3, 5, 6, 7 (bottom 4 elements)\n• Head of stack_a (Node #0, value = 1) is the\n  TOP of Stack A (first element affected by\n  sa, pb, ra).\n• Tail of stack_a (Node #7, value = 7) is the\n  BOTTOM of Stack A.\n• index is initialized to -1 for all nodes\n  (ready for pre-sort coordinate compression).",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key Structural Takeaways:\n• Order is strictly preserved:\n  \"1 2 4 8\" -> 1, 2, 4, 8 (top 4 elements)\n  3 5 6 7   -> 3, 5, 6, 7 (bottom 4 elements)\n• Head of stack_a (Node #0, value = 1) is the\n  TOP of Stack A (first element affected by\n  sa, pb, ra).\n• Tail of stack_a (Node #7, value = 7) is the\n  BOTTOM of Stack A.\n• index is initialized to -1 for all nodes\n  (ready for pre-sort coordinate compression).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
