      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "i = 0; sign = 1; num = 0;\nif (str[i] == '+' || str[i] == '-') {\n  if (str[i] == '-') sign = -1;\n  i++;\n}",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i = 0; sign = 1; num = 0;\nif (str[i] == '+' || str[i] == '-') {\n  if (str[i] == '-') sign = -1;\n  i++;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
