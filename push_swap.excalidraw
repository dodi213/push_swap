    {
      "id": "txt_b8R_qFl9DfqvLW",
      "type": "text",
      "x": 905.0,
      "y": 3677.0,
      "width": 290.08000000000004,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9K",
