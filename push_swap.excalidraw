    {
      "id": "txt_SJ6ovBStboIGhA",
      "type": "text",
      "x": 1446.0,
      "y": 2595.0,
      "width": 431.20000000000005,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b61",
      "roundness": null,
      "seed": 520945043,
      "version": 1,
      "versionNonce": 623579662,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "2. process_tokens(tokens, &cfg) -> j = 0:\n   \u2022 validate_and_add(\"5\", &cfg) -> num = 5, sign = +1\n   \u2022 has_duplicate(stack_a, 5):\n     scans [1, 2, 4, 8, 3] -> 0 (unique!)\n   \u2022 append_node(&stack_a, 5):\n     allocates Node #5 (val=5)\n     walks curr to tail Node #4 (val=3)\n     links tail->next = Node #5, Node #5->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. process_tokens(tokens, &cfg) -> j = 0:\n   \u2022 validate_and_add(\"5\", &cfg) -> num = 5, sign = +1\n   \u2022 has_duplicate(stack_a, 5):\n     scans [1, 2, 4, 8, 3] -> 0 (unique!)\n   \u2022 append_node(&stack_a, 5):\n     allocates Node #5 (val=5)\n     walks curr to tail Node #4 (val=3)\n     links tail->next = Node #5, Node #5->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
