      "text": "if (!str[i])\n  return (0);\n/* Rejects bare \"+\" or \"-\"\n   with no digits after! */",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if (!str[i])\n  return (0);\n/* Rejects bare \"+\" or \"-\"\n   with no digits after! */",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
