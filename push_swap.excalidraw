      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "append_node(&cfg->stack_a, (int)(num * sign)):\n  \u2022 if (has_duplicate(*stack, val)) return (0);\n  \u2022 new_node = malloc(sizeof(t_node));\n  \u2022 Links to tail of cfg->stack_a\n  \u2022 Returns 1 on success",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "append_node(&cfg->stack_a, (int)(num * sign)):\n  \u2022 if (has_duplicate(*stack, val)) return (0);\n  \u2022 new_node = malloc(sizeof(t_node));\n  \u2022 Links to tail of cfg->stack_a\n  \u2022 Returns 1 on success",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
