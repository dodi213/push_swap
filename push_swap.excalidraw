      "seed": 500108029,
      "version": 256,
      "versionNonce": 2099863338,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368030,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "1. Starts with \"--\"? No\n2. validate_and_add(\"1\", &cfg):\n   • sign = +1, num = 1\n   • 1 <= INT_MAX (OK)\n3. append_node(&stack_a, 1):\n   • has_duplicate(NULL, 1) -> 0\n   • malloc(t_node) -> val=1, idx=-1\n   • stack_a is NULL -> becomes HEAD!",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Starts with \"--\"? No\n2. validate_and_add(\"1\", &cfg):\n   • sign = +1, num = 1\n   • 1 <= INT_MAX (OK)\n3. append_node(&stack_a, 1):\n   • has_duplicate(NULL, 1) -> 0\n   • malloc(t_node) -> val=1, idx=-1\n   • stack_a is NULL -> becomes HEAD!",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
