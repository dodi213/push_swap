      "isDeleted": false,
      "boundElements": [],
      "updated": 1792858563576,
      "created": 1792858225135,
      "link": null,
      "locked": false,
      "text": "if !split\nreturn 0;",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if !split\nreturn 0;",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KTBpnX1aMinx2NDH_dK7n",
      "type": "text",
      "x": -198.01484840778073,
      "y": 922.1999341447439,
      "width": 548.0421958738043,
      "height": 40,
      "angle": 0,
      "strokeColor": "#4dabf7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
