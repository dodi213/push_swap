    {
      "id": "txt_hw8TmnGD2PrJCM",
      "type": "text",
      "x": 4237.9998779296875,
      "y": 2785,
      "width": 504.00000000000006,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5I",
      "roundness": null,
      "seed": 520960640,
      "version": 256,
      "versionNonce": 1933557290,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368030,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "1. Frees each heap string: free(tokens[0]), free(tokens[1]),\n   free(tokens[2]), free(tokens[3]).\n2. Frees the pointer array itself: free(tokens).\n3. Prevents memory leaks between argv[i] iterations!\n4. Increments i++ (i becomes 2).",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Frees each heap string: free(tokens[0]), free(tokens[1]),\n   free(tokens[2]), free(tokens[3]).\n2. Frees the pointer array itself: free(tokens).\n3. Prevents memory leaks between argv[i] iterations!\n4. Increments i++ (i becomes 2).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
