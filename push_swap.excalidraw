    },
    {
      "id": "txt_MWmxdwamz9gHyP",
      "type": "text",
      "x": 2040.0,
      "y": 3625.0,
      "width": 815.3600000000001,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Z",
      "roundness": null,
      "seed": 176134114,
      "version": 1,
      "versionNonce": 993689177,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "Triggers that cause parser failure:\n  \u2022 Empty/whitespace string: ./push_swap \"\"  or  ./push_swap \"   \"   \u2500\u2500\u25ba !tokens || !tokens[0]\n  \u2022 Unknown flag:            ./push_swap --fast 1 2                   \u2500\u2500\u25ba parse_flag() returns 0\n  \u2022 Non-numeric chars:       ./push_swap \"1 2a 4\"                     \u2500\u2500\u25ba validate_and_add() returns 0\n  \u2022 Integer overflow:        ./push_swap 2147483648                   \u2500\u2500\u25ba num > INT_MAX returns 0\n  \u2022 Duplicate number:        ./push_swap \"1 2 4 8\" 3 4                \u2500\u2500\u25ba has_duplicate() returns 1 -> 0\n  \u2022 Only flags (no numbers): ./push_swap --bench                      \u2500\u2500\u25ba !cfg->stack_a after loop",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Triggers that cause parser failure:\n  \u2022 Empty/whitespace string: ./push_swap \"\"  or  ./push_swap \"   \"   \u2500\u2500\u25ba !tokens || !tokens[0]\n  \u2022 Unknown flag:            ./push_swap --fast 1 2                   \u2500\u2500\u25ba parse_flag() returns 0\n  \u2022 Non-numeric chars:       ./push_swap \"1 2a 4\"                     \u2500\u2500\u25ba validate_and_add() returns 0\n  \u2022 Integer overflow:        ./push_swap 2147483648                   \u2500\u2500\u25ba num > INT_MAX returns 0\n  \u2022 Duplicate number:        ./push_swap \"1 2 4 8\" 3 4                \u2500\u2500\u25ba has_duplicate() returns 1 -> 0\n  \u2022 Only flags (no numbers): ./push_swap --bench                      \u2500\u2500\u25ba !cfg->stack_a after loop",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
