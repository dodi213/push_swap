    {
      "id": "txt_l7K8dpH3MOP7V4",
      "type": "text",
      "x": 3396.9998779296875,
      "y": 2435,
      "width": 290.08000000000004,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4R",
