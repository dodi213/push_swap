      "boundElements": [],
      "updated": 1792952326025,
      "created": 1792858225135,
      "link": null,
      "locked": false,
      "text": "if !split\nreturn 0;",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
