      "version": 1,
      "versionNonce": 759066860,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "2. process_tokens(tokens, &cfg) -> j = 0:\n   \u2022 validate_and_add(\"3\", &cfg) -> num = 3, sign = +1\n   \u2022 has_duplicate(stack_a, 3):\n     scans [1, 2, 4, 8] -> 0 (unique!)\n   \u2022 append_node(&stack_a, 3):\n     allocates Node #4 (val=3)\n     walks curr to tail Node #3 (val=8)\n     links tail->next = Node #4, Node #4->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. process_tokens(tokens, &cfg) -> j = 0:\n   \u2022 validate_and_add(\"3\", &cfg) -> num = 3, sign = +1\n   \u2022 has_duplicate(stack_a, 3):\n     scans [1, 2, 4, 8] -> 0 (unique!)\n   \u2022 append_node(&stack_a, 3):\n     allocates Node #4 (val=3)\n     walks curr to tail Node #3 (val=8)\n     links tail->next = Node #4, Node #4->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
