    {
      "id": "txt__DLWCfnHgMez8g",
      "type": "text",
      "x": 905.0,
      "y": 3862.0,
      "width": 368.48,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9S",
      "roundness": null,
      "seed": 28950252,
      "version": 1,
      "versionNonce": 663407677,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "while (str[i]) {\n  if (str[i] < '0' || str[i] > '9') return (0);\n  num = (num * 10) + (str[i] - '0');\n  if ((sign==1 && num > INT_MAX) ||\n      (sign==-1 && -num < INT_MIN)) return (0);\n  i++;\n}",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while (str[i]) {\n  if (str[i] < '0' || str[i] > '9') return (0);\n  num = (num * 10) + (str[i] - '0');\n  if ((sign==1 && num > INT_MAX) ||\n      (sign==-1 && -num < INT_MIN)) return (0);\n  i++;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
