    {
      "id": "txt_7DBzaseXjG___N",
      "type": "text",
      "x": 3808.9998779296875,
      "y": 3195,
      "width": 431.20000000000005,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6N",
      "roundness": null,
      "seed": 958826653,
      "version": 256,
      "versionNonce": 670788522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368030,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "2. process_tokens(tokens, &cfg) -> j = 0:\n   • validate_and_add(\"6\", &cfg) -> num = 6, sign = +1\n   • has_duplicate(stack_a, 6):\n     scans [1, 2, 4, 8, 3, 5] -> 0 (unique!)\n   • append_node(&stack_a, 6):\n     allocates Node #6 (val=6)\n     walks curr to tail Node #5 (val=5)\n     links tail->next = Node #6, Node #6->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. process_tokens(tokens, &cfg) -> j = 0:\n   • validate_and_add(\"6\", &cfg) -> num = 6, sign = +1\n   • has_duplicate(stack_a, 6):\n     scans [1, 2, 4, 8, 3, 5] -> 0 (unique!)\n   • append_node(&stack_a, 6):\n     allocates Node #6 (val=6)\n     walks curr to tail Node #5 (val=5)\n     links tail->next = Node #6, Node #6->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
