      "boundElements": [],
      "updated": 1792858210801,
      "created": 1792858086362,
      "link": null,
      "locked": false,
      "text": "void free_split(char **split);\nIterates through a null-terminated array of strings, freeing each\nallocated string before freeing the main array pointer to prevent memory\nleaks.",
      "fontSize": 15.7698838344832,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void free_split(char **split);\nIterates through a null-terminated array of strings, freeing each allocated string before freeing the main array pointer to prevent memory leaks.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Wf0Yd5RnG7yfcMNq4yQOY",
      "type": "text",
      "x": 405.21618882160055,
      "y": 810.1707841794771,
      "width": 81.1159483446736,
      "height": 40,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
