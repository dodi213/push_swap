    {
      "id": "txt_l7K8dpH3MOP7V4",
      "type": "text",
      "x": 1594.0,
      "y": 1835.0,
      "width": 290.08000000000004,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4R",
      "roundness": null,
      "seed": 500108029,
      "version": 1,
      "versionNonce": 64287614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "1. Starts with \"--\"? No\n2. validate_and_add(\"1\", &cfg):\n   \u2022 sign = +1, num = 1\n   \u2022 1 <= INT_MAX (OK)\n3. append_node(&stack_a, 1):\n   \u2022 has_duplicate(NULL, 1) -> 0\n   \u2022 malloc(t_node) -> val=1, idx=-1\n   \u2022 stack_a is NULL -> becomes HEAD!",
      "fontSize": 14.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Starts with \"--\"? No\n2. validate_and_add(\"1\", &cfg):\n   \u2022 sign = +1, num = 1\n   \u2022 1 <= INT_MAX (OK)\n3. append_node(&stack_a, 1):\n   \u2022 has_duplicate(NULL, 1) -> 0\n   \u2022 malloc(t_node) -> val=1, idx=-1\n   \u2022 stack_a is NULL -> becomes HEAD!",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
