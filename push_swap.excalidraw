    {
      "id": "txt_MWmxdwamz9gHyP",
      "type": "text",
      "x": 3842.9998779296875,
      "y": 4225,
      "width": 815.3600000000001,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Z",
      "roundness": null,
      "seed": 176134114,
      "version": 256,
      "versionNonce": 228137258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368031,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "Triggers that cause parser failure:\n  • Empty/whitespace string: ./push_swap \"\"  or  ./push_swap \"   \"   ──► !tokens || !tokens[0]\n  • Unknown flag:            ./push_swap --fast 1 2                   ──► parse_flag() returns 0\n  • Non-numeric chars:       ./push_swap \"1 2a 4\"                     ──► validate_and_add() returns 0\n  • Integer overflow:        ./push_swap 2147483648                   ──► num > INT_MAX returns 0\n  • Duplicate number:        ./push_swap \"1 2 4 8\" 3 4                ──► has_duplicate() returns 1 -> 0\n  • Only flags (no numbers): ./push_swap --bench                      ──► !cfg->stack_a after loop",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Triggers that cause parser failure:\n  • Empty/whitespace string: ./push_swap \"\"  or  ./push_swap \"   \"   ──► !tokens || !tokens[0]\n  • Unknown flag:            ./push_swap --fast 1 2                   ──► parse_flag() returns 0\n  • Non-numeric chars:       ./push_swap \"1 2a 4\"                     ──► validate_and_add() returns 0\n  • Integer overflow:        ./push_swap 2147483648                   ──► num > INT_MAX returns 0\n  • Duplicate number:        ./push_swap \"1 2 4 8\" 3 4                ──► has_duplicate() returns 1 -> 0\n  • Only flags (no numbers): ./push_swap --bench                      ──► !cfg->stack_a after loop",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
