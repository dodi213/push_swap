      "versionNonce": 301751878,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792860000000,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "Why argc = 6 (and not 9)?\n\u2022 Quotes around \"1 2 4 8\" make the shell keep spaces inside ONE string (argv[1]).\n\u2022 Unquoted 3, 5, 6, 7 are split by the shell into separate strings (argv[2..5]).",
      "fontSize": 16.0,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why argc = 6 (and not 9)?\n\u2022 Quotes around \"1 2 4 8\" make the shell keep spaces inside ONE string (argv[1]).\n\u2022 Unquoted 3, 5, 6, 7 are split by the shell into separate strings (argv[2..5]).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
