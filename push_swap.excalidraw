      "type": "text",
      "x": 3252.9998779296875,
      "y": 4462,
      "width": 368.48,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
