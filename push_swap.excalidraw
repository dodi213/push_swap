      "text": "Shell Command:   ./push_swap   \"1 2 4 8\"   3   5   6   7      (argc = 6)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect_SPI35Vy9wrOn_p",
      "originalText": "Shell Command:   ./push_swap   \"1 2 4 8\"   3   5   6   7      (argc = 6)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "txt_svKyvXVZ-UZu9a",
      "type": "text",
      "x": 3782.9998779296875,
      "y": 1780,
      "width": 725.7600000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 261785565,
      "version": 256,
      "versionNonce": 960585066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368029,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "Why argc = 6 (and not 9)?\n• Quotes around \"1 2 4 8\" make the shell keep spaces inside ONE string (argv[1]).\n• Unquoted 3, 5, 6, 7 are split by the shell into separate strings (argv[2..5]).",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why argc = 6 (and not 9)?\n• Quotes around \"1 2 4 8\" make the shell keep spaces inside ONE string (argv[1]).\n• Unquoted 3, 5, 6, 7 are split by the shell into separate strings (argv[2..5]).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
