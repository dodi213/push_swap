      "index": "b0g",
      "roundness": null,
      "seed": 1051182558,
      "version": 219,
      "versionNonce": 2126354370,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792858381131,
      "created": 1792858367928,
      "link": null,
      "locked": false,
      "text": "Traverses a doubly linked stack, freeing every node along the way and\nsetting the root pointer to NULL.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Traverses a doubly linked stack, freeing every node along the way and setting the root pointer to NULL.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
