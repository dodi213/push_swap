    {
      "id": "txt_VauGGL34jfyxYu",
      "type": "text",
      "x": 2688.9998779296875,
      "y": 3195,
      "width": 431.20000000000005,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5e",
      "roundness": null,
      "seed": 155078524,
      "version": 256,
      "versionNonce": 1433535146,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792952368030,
      "created": 1792860000000,
      "link": null,
      "locked": false,
      "text": "2. process_tokens(tokens, &cfg) -> j = 0:\n   • validate_and_add(\"3\", &cfg) -> num = 3, sign = +1\n   • has_duplicate(stack_a, 3):\n     scans [1, 2, 4, 8] -> 0 (unique!)\n   • append_node(&stack_a, 3):\n     allocates Node #4 (val=3)\n     walks curr to tail Node #3 (val=8)\n     links tail->next = Node #4, Node #4->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. process_tokens(tokens, &cfg) -> j = 0:\n   • validate_and_add(\"3\", &cfg) -> num = 3, sign = +1\n   • has_duplicate(stack_a, 3):\n     scans [1, 2, 4, 8] -> 0 (unique!)\n   • append_node(&stack_a, 3):\n     allocates Node #4 (val=3)\n     walks curr to tail Node #3 (val=8)\n     links tail->next = Node #4, Node #4->prev = tail\n3. free_split(tokens) -> frees tokens[0] & tokens array",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
